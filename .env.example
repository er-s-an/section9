# Fill only your own model credential in local .env (gitignored, mode 0600).
EVOMAP_MODEL_API_KEY=
S9_MODEL=evomap-gpt-5.6-luna
S9_MODEL_URL=https://api.evomap.ai/v1/chat/completions
S9_CREDENTIAL_REVISION=unversioned
S9_PORT=9019
S9_ENVIRONMENT=demo
S9_MODEL_CONCURRENCY=2
S9_MODEL_TIMEOUT=60
S9_RUN_TIMEOUT=180
S9_RUN_TOKEN_BUDGET=16000
# S9_DATA_DIR defaults to the repository's data/ directory.
# Worker credentials are generated at runtime; do not configure S9_AGENT_TOKEN here.
